{
  "name": "bd-admission-app",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "export:android": "expo export --platform android",
    "test": "node --test tests/*.test.ts scripts/tests/*.test.mjs",
    "test:import": "node --test tests/importer.test.ts scripts/tests/*.test.mjs",
    "packs:index": "node scripts/build-pack-index.mjs",
    "packs:validate": "node scripts/validate-question-pack.mjs",
    "question-assets:index": "node scripts/build-question-assets.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/hind-siliguri": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
