{
  "expo": {
    "name": "BD Admission",
    "slug": "bd-admission-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bdadmission",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.admissionbd.app"
    },
    "android": {
      "package": "com.admissionbd.app",
      "versionCode": 1,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": [
              "bn",
              "en"
            ],
            "ios": [
              "bn",
              "en"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f8f7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
